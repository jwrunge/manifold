import { describe, it, expect, beforeEach } from "vitest";
import evaluateExpression from "../src/expression-parser.ts";

describe("Assignment Operators", () => {
	let state: Record<string, unknown>;
	let ctx: Record<string, unknown>;

	beforeEach(() => {
		state = { count: 10, value: 5 };
		ctx = { state };
	});

	it("should handle postfix increment", () => {
		const expr = evaluateExpression("count++");
		const result = expr._fn(ctx);
		expect(result).toBe(10); // Returns old value
		expect(state.count).toBe(11); // State is updated
	});

	it("should handle postfix decrement", () => {
		const expr = evaluateExpression("count--");
		const result = expr._fn(ctx);
		expect(result).toBe(10); // Returns old value
		expect(state.count).toBe(9); // State is updated
	});

	it("should handle prefix increment", () => {
		const expr = evaluateExpression("++count");
		const result = expr._fn(ctx);
		expect(result).toBe(11); // Returns new value
		expect(state.count).toBe(11); // State is updated
	});

	it("should handle prefix decrement", () => {
		const expr = evaluateExpression("--count");
		const result = expr._fn(ctx);
		expect(result).toBe(9); // Returns new value
		expect(state.count).toBe(9); // State is updated
	});

	it("should handle simple assignment", () => {
		const expr = evaluateExpression("count = 100");
		expr._fn(ctx);
		expect(state.count).toBe(100);
	});

	it("should handle += operator", () => {
		const expr = evaluateExpression("count += 5");
		expr._fn(ctx);
		expect(state.count).toBe(15);
	});

	it("should handle -= operator", () => {
		const expr = evaluateExpression("count -= 3");
		expr._fn(ctx);
		expect(state.count).toBe(7);
	});

	it("should handle *= operator", () => {
		const expr = evaluateExpression("count *= 2");
		expr._fn(ctx);
		expect(state.count).toBe(20);
	});

	it("should handle /= operator", () => {
		const expr = evaluateExpression("count /= 2");
		expr._fn(ctx);
		expect(state.count).toBe(5);
	});

	it("should handle %= operator", () => {
		state.count = 10;
		const expr = evaluateExpression("count %= 3");
		expr._fn(ctx);
		expect(state.count).toBe(1);
	});

	it("should handle $state reference", () => {
		const expr = evaluateExpression("$state.count");
		const result = expr._fn(ctx);
		expect(result).toBe(10);
	});

	it("should handle assignment to $state properties", () => {
		const expr = evaluateExpression("$state.count = 200");
		expr._fn(ctx);
		expect(state.count).toBe(200);
	});
});
