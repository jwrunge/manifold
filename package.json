{
	"name": "@jwrunge/manifold",
	"private": false,
	"version": "0.6.0",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/manifold.js",
	"module": "./dist/manifold.js",
	"types": "./dist/manifold.d.ts",
	"browser": "./dist/manifold.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/jwrunge/manifold.git"
	},
	"homepage": "https://github.com/jwrunge/manifold",
	"bugs": {
		"url": "https://github.com/jwrunge/manifold/issues"
	},
	"files": [
		"dist/",
		"src/",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"description": "A small, fast reactive templating and state-management library for the modern web.",
	"keywords": [
		"reactive",
		"templating",
		"state-management",
		"no-build",
		"javascript",
		"typescript",
		"dom",
		"framework"
	],
	"author": "jwrunge",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./dist/manifold.d.ts",
			"import": "./dist/manifold.js",
			"default": "./dist/manifold.js"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && node ./minify.js && cp src/manifold.d.ts dist/manifold.d.ts",
		"test": "vitest --run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"sync:meta": "node ./scripts/sync-meta.js"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@types/node": "^24.5.2",
		"jsdom": "^26.1.0",
		"terser": "^5.44.0",
		"vite": "^7.1.7",
		"vitest": "^3.2.4"
	}
}
